# ---------------------------------------------------------------------------
# OilTrace AI configuration. Copy to .env and edit. Everything here is free.
# ---------------------------------------------------------------------------

# --- AIS source -------------------------------------------------------------
# sim  = built-in traffic simulator, no key, no network      (default)
# live = real vessel traffic from aisstream.io               (needs the key below)
# off  = no AIS collector

# Free key: sign in at https://aisstream.io with GitHub, then create an API key.
# Takes about 30 seconds. Paste it here and set AIS_SOURCE=live above.
AISSTREAM_API_KEY=

# --- area of interest -------------------------------------------------------
# Keep this tight. aisstream.io applies per-user bandwidth limits (tightened in
# September 2026) and a wide box burns the budget for vessels you do not care
# about. Default is the Arabian Sea off Mumbai / Alibag.
AOI_NAME=Arabian Sea - Mumbai
AOI_LAT_MIN=17.90
AOI_LAT_MAX=19.80
AOI_LON_MIN=71.50
AOI_LON_MAX=73.30

# --- ingest tuning ----------------------------------------------------------
AIS_MIN_INTERVAL_SECONDS=30     # store at most one position per vessel per 30 s
AIS_FLUSH_SECONDS=5             # batch writes
AIS_RETENTION_DAYS=14           # prune older positions

# --- drift model ------------------------------------------------------------
WIND_DRIFT_FACTOR=0.03          # slick moves with current + 3% of wind
WIND_DEFLECTION_DEG=15          # Coriolis deflection, right in the N hemisphere
DRIFT_PARTICLES=600
DRIFT_MAX_HOURS=24

# --- attribution ------------------------------------------------------------
CANDIDATE_RADIUS_KM=25          # screening radius around the back-drift cone
PERSISTENCE_RADIUS_KM=8         # tighter box for "was it loitering?"

# --- Global Fishing Watch ---------------------------------------------------
# The only free vessel data covering Indian waters. Free non-commercial token
# from https://globalfishingwatch.org/our-apis/tokens
GFW_API_TOKEN=

# --- active region ----------------------------------------------------------
# mumbai | gulf-of-kutch | north-sea | english-channel | gulf-of-mexico | singapore
OILTRACE_REGION=mumbai
